---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, euro } from '../data/site';
import { berichten } from '../data/gastenboek';
import { faq, faqSchema } from '../data/faq';

import hero from '../assets/img/terras-gete-1.jpg';
import gevel from '../assets/img/gevel.jpg';
import greetJo from '../assets/img/greet-en-jo.jpg';
import slaapkamer from '../assets/img/slaapkamer-4.jpg';
import keuken from '../assets/img/keuken-1.jpg';
import zithoek from '../assets/img/zithoek-3.jpg';
import terras from '../assets/img/terras-2.jpg';
import ontbijt from '../assets/img/keuken-5.jpg';
import vinne from '../assets/img/vinne.jpg';
import wandelen from '../assets/img/wandelen-getevallei.jpg';
import eikske from '../assets/img/eikske.jpg';

const uitgelicht = berichten.filter((b) => b.uitgelicht).slice(0, 3);
const jarenOpen = new Date().getFullYear() - site.geopendIn;

const ruimtes = [
  { foto: slaapkamer, titel: 'Twee slaapkamers', tekst: 'Boven, met de badkamer ernaast.', alt: 'Tweepersoonsbed met witte lakens en roze kussens in een gastenkamer van Het Getehof' },
  { foto: keuken, titel: 'Eigen keuken', tekst: 'Kook met streekproducten uit het Hageland.', alt: 'Witte keuken met oven, koelkast en eettafel in Het Getehof' },
  { foto: zithoek, titel: 'Zithoek met tv', tekst: 'Knus bijkomen na een dag fietsen.', alt: 'Lederen zetel en salontafel in de zithoek van Het Getehof' },
  { foto: terras, titel: 'Tuin en terras', tekst: 'Ontbijten in de zon, een glas wijn bij valavond.', alt: 'Tuinterras met houten tafel en parasol in Het Getehof' },
];

const omgeving = [
  { plek: 'Natuurdomein Het Vinne, Zoutleeuw', afstand: '10 min met de auto' },
  { plek: 'Museum Derde Regiment Lansiers, Orsmaal', afstand: '3 km' },
  { plek: 'Tienen en Sint-Truiden', afstand: 'een tiental kilometer' },
  { plek: 'Wandelnetwerk Getevallei', afstand: 'vanaf de deur' },
];
---

<Base
  title="B&B in het Hageland, vlak bij Zoutleeuw"
  description={`B&B in het Hageland: ${site.kamers} gastenkamers voor ${site.maxPersonen} personen in ${site.dorp} (${site.gemeente}), met tuin en terras aan de Gete. Het huis is voor jou alleen. Vanaf €${site.prijsVanaf}.`}
  overlayHeader
  schema={[faqSchema(faq.slice(0, 4))]}
>
  <section class="hero">
    <Image src={hero} alt="Zitplek met teakhouten stoelen en tafel aan de oever van de Kleine Gete, in de tuin van Het Getehof" widths={[800, 1400, 2000, 2400]} sizes="100vw" class="hero-img" loading="eager" fetchpriority="high" layout="none" />
    <div class="hero-shade"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow light">B&amp;B · {site.dorp} · {site.streek}</p>
      <h1>B&amp;B in het Hageland, aan de oever van de Gete</h1>
      <p class="hero-lead">
        Een vakantiewoning met twee gastenkamers in {site.dorp}, vlak bij Zoutleeuw. Tijdens je verblijf is het huis helemaal
        van jou.
      </p>
      <div class="hero-actions">
        <a href="/boeken" class="btn btn-light">Beschikbaarheid vragen</a>
        <a href="/kamers" class="btn btn-ghost">Bekijk de kamers</a>
      </div>
    </div>
    <dl class="wrap facts">
      <div><dt>Gastenkamers</dt><dd>{site.kamers}</dd></div>
      <div><dt>Personen</dt><dd>tot {site.maxPersonen}</dd></div>
      <div><dt>Per kamer</dt><dd>vanaf {euro(site.prijsVanaf)}</dd></div>
      <div><dt>Open sinds</dt><dd>{site.geopendIn}</dd></div>
    </dl>
  </section>

  <section class="section intro">
    <div class="wrap intro-grid">
      <div class="intro-text reveal">
        <span class="eyebrow">Welkom in Het Getehof</span>
        <h2>Een heel huis, alleen voor jou en je gezelschap</h2>
        <p class="lead">
          Het Getehof is een gezellige vakantiewoning in het centrum van {site.dorp}, deelgemeente van {site.gemeente}. Er zijn
          geen andere gasten tijdens je verblijf: de keuken, de zithoek, de badkamer en de tuin deel je met niemand.
        </p>
        <p>
          Ten oosten van Leuven, vlak bij de Limburgse grens, ligt het groene Hageland. {site.gemeente} ligt middenin de Getevallei,
          op fietsafstand van het middeleeuwse kunststadje Zoutleeuw en het provinciaal domein Het Vinne. De fiets- en
          wandelroutes beginnen aan de voordeur.
        </p>
        <a href="/omgeving" class="text-link">Meer over de omgeving <span aria-hidden="true">→</span></a>
      </div>
      <div class="intro-media reveal">
        <Image src={gevel} alt="Bakstenen gevel van Het Getehof met voortuin, buxushagen en een oude waterpomp" widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 50vw" class="media-main" layout="none" />
        <figure class="host">
          <Image src={greetJo} alt="Greet en Jo, de gastheer en gastvrouw van Het Getehof" widths={[300, 500]} sizes="220px" layout="none" />
          <figcaption>
            <strong>{site.uitbaters}</strong>
            <span>ontvangen je al {jarenOpen} jaar</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section rooms">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Kamers &amp; ruimtes</span>
          <h2>Twee kamers, een keuken, een zithoek en een tuin</h2>
        </div>
        <a href="/kamers" class="btn btn-primary">Alle foto's van de kamers</a>
      </div>
      <div class="room-grid">
        {
          ruimtes.map((r, i) => (
            <a href={i === 3 ? '/tuin-en-terras' : '/kamers'} class:list={['room', `room-${i}`, 'reveal']}>
              <Image src={r.foto} alt={r.alt} widths={[500, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" layout="none" />
              <div class="room-label">
                <h3>{r.titel}</h3>
                <p>{r.tekst}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gete">
    <div class="wrap gete-grid">
      <div class="gete-media reveal">
        <Image src={ontbijt} alt="Gedekte ontbijttafel met koffiekopjes en servetten in Het Getehof" widths={[600, 1000]} sizes="(max-width: 860px) 100vw, 45vw" layout="none" />
      </div>
      <div class="gete-text reveal">
        <span class="eyebrow light">Wat gasten het vaakst noemen</span>
        <blockquote>
          <p>“Gastvrouw Greet ontvangt je hartelijk en bezorgt je een heerlijk ontbijt. De rustige omgeving krijg je er gratis bij.”</p>
          <footer>Luc uit Gent, in het gastenboek</footer>
        </blockquote>
        <a href="/gastenboek" class="btn btn-light">Lees het gastenboek</a>
      </div>
    </div>
  </section>

  <section class="section reviews">
    <div class="wrap">
      <span class="eyebrow">Gastenboek</span>
      <h2 class="reveal">Wat gasten over hun verblijf schreven</h2>
      <div class="review-grid">
        {
          uitgelicht.map((b) => (
            <figure class="review reveal">
              <p class="quote">“{b.uitgelicht}”</p>
              <p class="full">{b.tekst.length > 220 ? b.tekst.slice(0, 220).replace(/\s\S*$/, '') + '…' : b.tekst}</p>
              <figcaption>
                {b.naam}
                {b.woonplaats && <span> uit {b.woonplaats}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section area">
    <div class="wrap area-grid">
      <div class="area-text reveal">
        <span class="eyebrow">Omgeving</span>
        <h2>Fietsen en wandelen in de Getevallei</h2>
        <p>
          Het wandelnetwerk Getevallei werd in 2016 verkozen tot beste wandelproduct van België. Fietsers zitten meteen op de
          knooppunten van Vlaams-Brabant en de LF6 Vlaanderen Fietsroute, en hun fiets staat 's nachts binnen.
        </p>
        <ul class="distances">
          {omgeving.map((o) => <li><span>{o.plek}</span><span>{o.afstand}</span></li>)}
        </ul>
        <a href="/omgeving" class="text-link">Meer over de streek <span aria-hidden="true">→</span></a>
      </div>
      <div class="area-mosaic">
        <Image src={vinne} alt="Knuppelpad over het water in natuurdomein Het Vinne in Zoutleeuw" widths={[500, 900]} sizes="(max-width: 860px) 100vw, 30vw" class="m1 reveal" layout="none" />
        <Image src={wandelen} alt="Wandelaars in de Getevallei met de dorpskerk op de achtergrond" widths={[300, 500]} sizes="(max-width: 860px) 50vw, 15vw" class="m2 reveal" layout="none" />
        <Image src={eikske} alt="Kapel 't Eikske op de grens van Neerhespen, Zoutleeuw en Landen" widths={[300, 600]} sizes="(max-width: 860px) 50vw, 15vw" class="m3 reveal" layout="none" />
      </div>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap faq-grid">
      <div>
        <span class="eyebrow">Goed om te weten</span>
        <h2>Veelgestelde vragen</h2>
        <p>Staat je vraag er niet bij? Bel Greet op <a href={`tel:${site.telefoonE164}`}>{site.telefoon}</a>.</p>
      </div>
      <Faq vragen={faq.slice(0, 4)} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    color: var(--white);
    isolation: isolate;
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    z-index: -2;
    animation: slowzoom 18s ease-out both;
  }
  @keyframes slowzoom {
    from {
      transform: scale(1.08);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(23 28 18 / 45%) 0%, rgb(23 28 18 / 0%) 60%),
      linear-gradient(180deg, rgb(23 28 18 / 55%) 0%, rgb(23 28 18 / 0%) 30%),
      linear-gradient(0deg, rgb(23 28 18 / 88%) 0%, rgb(23 28 18 / 30%) 55%, rgb(23 28 18 / 5%) 100%);
  }
  .hero-inner {
    align-self: end;
    padding-top: 140px;
    padding-bottom: 40px;
  }
  .hero h1 {
    max-width: 14ch;
    font-weight: 400;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    max-width: 46ch;
    opacity: 0.92;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .eyebrow.light {
    color: var(--sage);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 0;
    margin-bottom: 0;
    border-top: 1px solid rgb(255 255 255 / 22%);
    padding-block: 22px 28px;
  }
  .facts div {
    padding-right: 16px;
  }
  .facts dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
  .facts dd {
    margin: 4px 0 0;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
  }
  .text-link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--khaki);
    padding-bottom: 2px;
  }
  .intro-media {
    position: relative;
    padding-bottom: 60px;
  }
  .media-main {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .host {
    position: absolute;
    left: -32px;
    bottom: 0;
    margin: 0;
    background: var(--white);
    padding: 10px 10px 14px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    width: 230px;
    transform: rotate(-2deg);
  }
  .host :global(img) {
    border-radius: 12px;
    aspect-ratio: 4/3;
    object-fit: cover;
    width: 100%;
  }
  .host figcaption {
    display: flex;
    flex-direction: column;
    padding: 10px 6px 0;
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .host strong {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
  }
  .host span {
    color: var(--muted);
  }

  .rooms {
    background: var(--sage);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .section-head h2 {
    max-width: 18ch;
    margin: 0;
  }
  .room-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 250px;
    gap: 16px;
  }
  .room {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }
  .room :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .room:hover :global(img) {
    transform: scale(1.05);
  }
  .room::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(23 28 18 / 75%), rgb(23 28 18 / 0%) 55%);
    z-index: -1;
  }
  .room-0 {
    grid-column: span 7;
    grid-row: span 2;
  }
  .room-0 :global(img) {
    object-position: 50% 85%;
  }
  .room-1 {
    grid-column: span 5;
  }
  .room-2 {
    grid-column: span 5;
  }
  .room-3 {
    grid-column: span 12;
  }
  .room-label {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
  }
  .room-label h3 {
    margin: 0 0 4px;
  }
  .room-label p {
    margin: 0;
    opacity: 0.88;
    font-size: 0.95rem;
  }

  .gete {
    background: var(--ink);
    color: var(--white);
    padding-block: clamp(64px, 10vw, 120px);
  }
  .gete-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }
  .gete-media :global(img) {
    border-radius: var(--radius);
    aspect-ratio: 1;
    object-fit: cover;
    width: 100%;
  }
  blockquote {
    margin: 0 0 32px;
  }
  blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    line-height: 1.25;
    font-weight: 350;
  }
  blockquote footer {
    color: var(--khaki);
    font-size: 0.95rem;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .review {
    margin: 0;
    background: var(--white);
    border-radius: var(--radius);
    padding: 32px 28px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .quote {
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.3;
  }
  .full {
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .review figcaption {
    font-weight: 600;
    font-size: 0.92rem;
    border-top: 1px solid rgb(23 28 18 / 10%);
    padding-top: 14px;
  }
  .review figcaption span {
    font-weight: 400;
    color: var(--muted);
  }

  .area {
    background: var(--sage-soft);
  }
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }
  .distances {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
  }
  .distances li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(23 28 18 / 12%);
  }
  .distances li span:last-child {
    color: var(--khaki-deep);
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }
  .area-mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 280px 220px;
    gap: 14px;
  }
  .area-mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .area-mosaic :global(.m1) {
    grid-column: span 2;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: clamp(32px, 6vw, 80px);
  }

  @media (max-width: 860px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 16px;
    }
    .intro-grid,
    .gete-grid,
    .area-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .host {
      left: 12px;
      width: 190px;
    }
    .room-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 220px;
    }
    .room-0 {
      grid-column: span 2;
    }
    .room-1,
    .room-2 {
      grid-column: span 1;
    }
    .room-3 {
      grid-column: span 2;
    }
    .review-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .room-1,
    .room-2 {
      grid-column: span 2;
    }
    .area-mosaic {
      grid-template-rows: 220px 170px;
    }
  }
</style>
