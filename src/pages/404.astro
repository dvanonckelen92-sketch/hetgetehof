---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer). Ga terug naar de homepage van Het Getehof, B&B in het Hageland." noindex>
  <section class="page-head wrap nf">
    <span class="eyebrow">404</span>
    <h1>Deze pagina bestaat niet (meer)</h1>
    <p class="lead">Misschien zocht je een van deze pagina's:</p>
    <p class="links">
      <a class="btn btn-primary" href="/">Naar de homepage</a>
      <a class="btn btn-ghost" href="/kamers">Kamers</a>
      <a class="btn btn-ghost" href="/boeken">Prijs &amp; boeken</a>
    </p>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
