---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
  label: string;
}
const { fotos, label } = Astro.props;
const groot = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 1600, format: 'webp', quality: 72 })));
---

<div class="gallery" data-gallery aria-label={label} role="list">
  {
    fotos.map((f, i) => (
      <button type="button" class="item" data-full={groot[i].src} data-alt={f.alt} role="listitem">
        <Image src={f.src} alt={f.alt} widths={[400, 700, 1000]} sizes="(max-width: 700px) 50vw, 33vw" layout="none" />
        <span class="zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
        </span>
      </button>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Foto vergroot">
  <img alt="" data-lightbox-img />
  <p data-lightbox-caption></p>
  <button type="button" class="close" data-lightbox-close aria-label="Sluiten">×</button>
  <button type="button" class="prev" data-lightbox-prev aria-label="Vorige foto">‹</button>
  <button type="button" class="next" data-lightbox-next aria-label="Volgende foto">›</button>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('button.item')];
    let index = 0;
    const show = (i: number) => {
      index = (i + items.length) % items.length;
      img.src = items[index].dataset.full!;
      img.alt = items[index].dataset.alt!;
      caption.textContent = items[index].dataset.alt!;
    };
    items.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      })
    );
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>

<style>
  .gallery {
    columns: 3 260px;
    column-gap: 14px;
  }
  .item {
    display: block;
    width: 100%;
    margin: 0 0 14px;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    break-inside: avoid;
  }
  .item :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .item:hover :global(img) {
    transform: scale(1.04);
  }
  .zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(255 254 251 / 88%);
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .item:hover .zoom,
  .item:focus-visible .zoom {
    opacity: 1;
  }
  .zoom svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
  }
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgb(23 28 18 / 92%);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    grid-template-rows: 1fr auto;
  }
  .lightbox img {
    max-width: min(92vw, 1600px);
    max-height: 82dvh;
    width: auto;
    object-fit: contain;
    border-radius: 6px;
    align-self: end;
  }
  .lightbox p {
    color: #e6e8e1;
    font-size: 0.95rem;
    padding: 14px 20px 24px;
    text-align: center;
    margin: 0;
  }
  .lightbox button {
    position: fixed;
    border: 0;
    background: rgb(255 255 255 / 12%);
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox button:hover {
    background: rgb(255 255 255 / 24%);
  }
  .close {
    top: 16px;
    right: 16px;
  }
  .prev {
    left: 16px;
    top: 50%;
  }
  .next {
    right: 16px;
    top: 50%;
  }
  @media (max-width: 560px) {
    .gallery {
      columns: 2;
      column-gap: 10px;
    }
    .item {
      margin-bottom: 10px;
    }
    .prev,
    .next {
      top: auto;
      bottom: 16px;
    }
  }
</style>
